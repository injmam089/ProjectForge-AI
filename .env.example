# ==============================================================================
# ProjectForge AI — Environment Configuration Example
# Copy this file to .env before starting the services locally.
# Never commit actual credentials or secret keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Docker Compose & Backend)
# ------------------------------------------------------------------------------
POSTGRES_DB=projectforge
POSTGRES_USER=projectforge_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Spring Boot Backend Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/projectforge
SPRING_DATASOURCE_USERNAME=projectforge_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# Active Spring Profile (e.g., dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# CORS Allowed Origins (Comma-separated URLs for the frontend client)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# Container Ports
BACKEND_PORT=8080
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# Security & JWT Configuration (Phase 2)
# JWT_SECRET must be at least 64 bytes (512 bits) long for secure HS-512 signing.
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_64_byte_minimum_secret_key_for_hs512_signing_here_!
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# AI Provider Configuration (Phase 4: AI Requirement Analysis & Clarification)
# Backend-only. Never expose this key to the frontend or source control.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_placeholder
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
